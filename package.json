{
  "name": "tinyfy-editor-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "dev": "echo '[workspace:@i-prikot/playground] dev' && npm run dev --workspace=@i-prikot/playground",
    "build": "echo '[workspace:@i-prikot/editor-schema] build' && npm run build --workspace=@i-prikot/editor-schema && echo '[workspace:@i-prikot/editor] build' && npm run build --workspace=@i-prikot/editor && echo '[workspace:@i-prikot/editor-renderer] build' && npm run build --workspace=@i-prikot/editor-renderer && echo '[workspace:@i-prikot/playground] build' && npm run build --workspace=@i-prikot/playground",
    "typecheck": "echo '[workspace] typecheck' && vue-tsc --build",
    "lint": "npm run lint --workspaces --if-present && eslint test e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:locales": "node scripts/validate-editor-locales.mjs",
    "prepare": "node scripts/prepare-husky.cjs",
    "precommit": "lint-staged --concurrent 1 && npm run typecheck",
    "test:e2e": "playwright test",
    "test:release-verifiers": "node --experimental-strip-types --import ./scripts/register-release-verifier-test-loader.mjs scripts/run-release-verifier-tests.mjs test/scripts/verify-publish-tag.test.ts test/scripts/verify-publish-artifacts.test.ts test/scripts/verify-release-authorization.test.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "test:smoke": "node scripts/run-smoke-test.mjs",
    "test:scripts": "node --test test/scripts/generate-icons.test.mjs test/scripts/run-smoke-test.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.14.0",
    "happy-dom": "20.11.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "15.5.2",
    "prettier": "^3.9.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "glob": "13.0.6",
    "js-beautify": "2.0.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
